<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="16dp">

    <!-- 1. displayContainer (слева, 1/3) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/displayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/right_shape"
        android:clickable="true"
        android:focusable="true"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/centralPanel"
        app:layout_constraintHorizontal_weight="1">

        <!-- Текстовое поле теперь занимает всё пространство от верха до кнопки -->
        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="Нажмите для запуска приложения на виртуальном дисплее"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/stopButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- SurfaceView теперь корректно растягивается от верха до кнопки стоп -->
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/stopButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Кнопка ВНУТРИ дисплея, жестко прилипшая к его низу. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/stopButton"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:visibility="gone"
            android:background="@drawable/display_stop_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. centralPanel (в центре, 1/3) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centralPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:padding="2dp"
        android:background="@drawable/central_shape"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/displayContainer"
        app:layout_constraintEnd_toStartOf="@+id/sectionsContainer"
        app:layout_constraintHorizontal_weight="1">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textClock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="80sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="6dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toTopOf="@id/centralPanel"
            app:layout_constraintStart_toStartOf="@id/centralPanel"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DD  месяц"
            android:textSize="32dp"
            android:textColor="@color/white"
            android:layout_marginTop="90dp"
            android:layout_marginStart="38dp"
            app:layout_constraintTop_toTopOf="@id/centralPanel"/>

        <ImageView
            android:id="@+id/top_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@mipmap/com_background_top_shadow"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/textClock"
            app:layout_constraintStart_toStartOf="@id/centralPanel"/>

        <ImageView
            android:id="@+id/bottom_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@mipmap/com_background_bottom_shadow"
            android:layout_marginBottom="146dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/centralPanel"/>

        <com.seal93rus.HUdashboard.CarData.CarDataView
            android:id="@+id/carDataView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/fuel_state_icon"
                android:layout_width="74dp"
                android:layout_height="74dp"
                app:srcCompat="@mipmap/fuelstat"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fuel_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.0л"
                android:textSize="34sp"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/battary_icon"
                android:layout_width="74dp"
                android:layout_height="74dp"
                app:srcCompat="@mipmap/battary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/voltage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.0В"
                android:textSize="34sp"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/temp_dtc_icon"
                android:layout_width="74dp"
                android:layout_height="74dp"
                app:srcCompat="@mipmap/tempdtc" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/temp_dtc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.0С"
                android:textSize="38sp"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/eng_temp_icon"
                android:layout_width="74dp"
                android:layout_height="74dp"
                app:srcCompat="@mipmap/tempeng" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/eng_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.0С"
                android:textSize="38sp"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="horizontal"
                app:flow_wrapMode="chain"
                app:flow_maxElementsWrap="4"
                app:flow_horizontalStyle="spread"
                app:flow_verticalStyle="packed"
                app:flow_horizontalAlign="center"
                app:flow_verticalAlign="center"
                app:constraint_referenced_ids="eng_temp_icon,eng_temp,temp_dtc_icon,temp_dtc,battary_icon,voltage,fuel_state_icon,fuel_state"
                app:flow_horizontalGap="8dp"
                app:flow_verticalGap="20dp"/>
        </com.seal93rus.HUdashboard.CarData.CarDataView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/outside_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="58sp"
            android:textColor="@color/white"
            android:text="00C"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/weather"
            android:layout_width="130dp"
            android:layout_height="124dp"
            android:layout_marginTop="44dp"
            android:layout_marginEnd="140dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/textClock"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@mipmap/weather" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ac_button_increase"
            android:layout_width="89dp"
            android:layout_height="70dp"
            android:background="@drawable/ac_plus_button"
            android:layout_marginBottom="54dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintEnd_toStartOf="@id/ac_temp"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ac_button_decrease"
            android:layout_width="89dp"
            android:layout_height="70dp"
            android:background="@drawable/ac_minus_button"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="54dp"
            app:layout_constraintStart_toEndOf="@id/ac_temp"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ac_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00C"
            android:textSize="68sp"
            android:textColor="@color/white"
            android:layout_marginBottom="52dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. sectionsContainer (ViewPager2 справа, 1/3) -->
    <LinearLayout
        android:id="@+id/sectionsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/centralPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1">

        <!-- СЕКЦИЯ 1: ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
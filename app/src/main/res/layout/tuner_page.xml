<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tuner_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tuner"
        android:padding="28dp">


        <LinearLayout
            android:id="@+id/freqRow"
            android:layout_width="match_parent"
            android:layout_height="67dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="170dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSeekDown"
                android:layout_width="80dp"
                android:layout_height="45dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="30dp"
                android:background="@drawable/btnseekdown"/>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.6" />

            <TextView
                android:id="@+id/tvFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000.00"
                android:textColor="#BCB8B8"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFrequencyUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="MHz"
                android:textColor="#BCB8B8"
                android:textSize="30sp" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.6" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSeekUp"
                android:layout_width="80dp"
                android:layout_height="45dp"
                android:layout_marginEnd="30dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/btnseekup" />
        </LinearLayout>




        <TextView
            android:id="@+id/tvBand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="250dp"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#BCB8B8"
            android:text="FM"/>

        <!-- Ряд кнопок: только локальные команды. Play/Pause — только для онлайн-радио, здесь не нужен. -->

        <TextView
            android:id="@+id/tvSignal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="290dp"
            android:text="strength"
            android:textColor="#BCB8B8"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp">



            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnMute"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_unmute"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tunerNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text=""
            android:textColor="@android:color/black"
            android:textSize="14sp" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>